{
  "name": "scan-detection-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "app": "electron .",
    "dist": "vite build && electron-builder"
  },
  "dependencies": {
    "pinia": "^2.3.1",
    "vue": "^3.4.0",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "vite": "^5.0.0"
  },
  "build": {
    "appId": "com.scandetection.sd",
    "productName": "ScanDetection",
    "files": ["dist/**", "electron/**", "package.json"],
    "extraResources": [
      { "from": "backend", "to": "backend" },
      { "from": "python_embed", "to": "python_embed" },
      { "from": "models", "to": "models" },
      { "from": "tools", "to": "tools" }
    ],
    "win": {
      "target": "nsis",
      "icon": "electron/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false
    }
  }
}
